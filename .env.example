HOST=127.0.0.1
PORT=3000
AUTH_DIR=./.wwebjs_auth
MESSAGE_DELAY_MS=1500
# Obligatoria si HOST no es 127.0.0.1 o localhost.
API_KEY=
# Opcional: ruta a Chrome instalado si no se utiliza el navegador de Puppeteer.
PUPPETEER_EXECUTABLE_PATH=
# El Dockerfile lo activa para Chromium dentro del contenedor. Localmente, mantener false.
PUPPETEER_NO_SANDBOX=false
